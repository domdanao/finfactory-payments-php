{
    "name": "domdanao/finfactory-payments",
    "description": "PHP SDK for the FinFactory Payments Merchant API: payment intents, refunds, disputes and webhooks. No dependencies beyond ext-curl.",
    "type": "library",
    "keywords": ["finfactory", "payments", "qrph", "philippines", "checkout", "webhooks", "sdk"],
    "license": "MIT",
    "homepage": "https://github.com/domdanao/finfactory-payments/tree/main/php",
    "support": {
        "issues": "https://github.com/domdanao/finfactory-payments/issues",
        "source": "https://github.com/domdanao/finfactory-payments-php",
        "docs": "https://docs.payments.finfactory.dev/merchant/guides/overview/"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "chillerlan/php-qrcode": "^5.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0"
    },
    "suggest": {
        "ext-apcu": "To share Access Tokens between PHP-FPM requests with ApcuTokenCache.",
        "chillerlan/php-qrcode": "^5.0, to draw QR Ph codes as SVG with QrPh::svg() and PaymentIntent::qrphSvg()."
    },
    "autoload": {
        "psr-4": { "FinFactory\\Payments\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "FinFactory\\Payments\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
